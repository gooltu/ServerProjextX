# App
# In production these are supplied directly by ChatServerConf's EC2 user-data script
# (userdata/nodeapp.sh.tpl), not from a secret - see CLAUDE.md.
NODE_ENV=production
PORT=3000

# Database (knexfile_production.js)
# durl is supplied directly by the user-data script (the RDS endpoint, a Terraform
# output - not a secret). dusername/dpassword come from the serverprojectx/db-credentials
# AWS Secrets Manager secret ({"username","password"} JSON).
durl=
dusername=
dpassword=

# --- Everything below this line is supplied in production via the
# serverprojectx/app-secrets AWS Secrets Manager secret, flattened into this file by
# ChatServerConf's user-data script. AWS_REGION is the one exception - it's set directly
# by that script, deliberately excluded from app-secrets to avoid a last-write-wins
# blank-out when the secret's JSON is flattened on top. ---

# AWS S3 (jewelchat-uploads-prod, IAM user "serverprojectx-s3-uploader")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Firebase service account (utils/firebaseAdmin.js - used by App Check when enabled)
project_id=
private_key=
client_email=

# App Check (utils/appCheck.js) - gates registerPhoneNumber/verifyCode/getAccessToken
# behind Firebase App Check (Play Integrity / App Attest) when set to "true". Default off.
APP_CHECK_ENABLED=

# JWT signing secret (utils/config.js). Falls back to a hardcoded dev-only value if unset -
# setting this in production rotates the signing key, which invalidates every
# previously-issued access/refresh token.
JWT_SECRET=

# Other
prop_hr_ago=

# --- Test-only (NODE_ENV=test, see test/globalSetup.js). Never read in dev/production.
# All have safe local defaults matching docker-compose.test.yml; only needed if your local
# test DB diverges from those defaults. ---
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=
